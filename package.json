{
  "name": "signal-room-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A clean-room starter for building a creator intelligence workspace.",
  "scripts": {
    "dev": "concurrently -n web,bridge -c cyan,magenta \"next dev\" \"node --watch bridge/server.mjs\"",
    "dev:web": "next dev",
    "dev:bridge": "node --watch bridge/server.mjs",
    "build": "next build",
    "start": "next start",
    "bridge": "node bridge/server.mjs",
    "worker:transcript-analysis": "node scripts/transcript-analysis-worker.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run convex/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:board": "node scripts/board/dev.mjs",
    "board:doctor": "node scripts/board/doctor.mjs",
    "board:gate": "node scripts/board/gate.mjs",
    "test:e2e:board": "node scripts/board/e2e.mjs",
    "board:calibrate": "node scripts/board/calibrate.mjs",
    "board:stop": "node scripts/board/stop.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.121",
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@openai/codex-sdk": "^0.146.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.118",
    "convex": "^1.45.0",
    "idb": "^8.0.3",
    "next": "^16.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.57",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
