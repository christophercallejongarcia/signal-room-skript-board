{
  "name": "signal-room-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A clean-room starter for building a creator intelligence workspace.",
  "scripts": {
    "dev": "concurrently -n web,bridge -c cyan,magenta \"next dev\" \"node --watch bridge/server.mjs\"",
    "dev:web": "next dev",
    "dev:bridge": "node --watch bridge/server.mjs",
    "build": "next build",
    "start": "next start",
    "bridge": "node bridge/server.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.146.1",
    "@phosphor-icons/react": "^2.1.10",
    "convex": "^1.45.0",
    "next": "^16.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
